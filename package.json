{
  "name": "seriesoftubes",
  "version": "2.3.0",
  "description": "A cartoon browser game about running an Australian ISP and hosting provider.",
  "private": true,
  "license": "MIT",
  "homepage": "https://seriesoftubes.au/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesysadmindev/SeriesOfTubesAU.git"
  },
  "scripts": {
    "test": "node scripts/test.js",
    "test:timings": "node scripts/test-timings.js",
    "build": "node scripts/build.js",
    "i18n:check": "node scripts/i18n-check.js",
    "i18n:fix": "node scripts/i18n-check.js --fix",
    "dev": "node scripts/dev.js",
    "page": "node scripts/lib/page.js",
    "serve": "npm run build && npx --yes serve@14.2.4 _site",
    "perf": "node scripts/perf-bench.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "24.1.3",
